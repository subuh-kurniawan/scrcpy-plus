launch_on_display_cmd() {
  ensure_adb
  local target_did
  target_did="$(wait_for_virtual_display_id "$launch_display_id")"
  if [[ -z "$target_did" || "$target_did" == "0" ]]; then
    echo "Error: Virtual display DeX belum aktif." >&2
    exit 1
  fi

  if [[ "$launch_landscape" -eq 1 ]]; then
    apply_display_rotation_internal "$target_did" "landscape"
  fi

  local query="$launch_display_app"
  if [[ "$query" == +* ]]; then
    launch_force_stop=1
    query="${query#+}"
  fi

  local resolved
  resolved="$(resolve_package_and_activity "$query")"
  local pkg="${resolved%%|*}"
  local comp="${resolved#*|}"

  if [[ -z "$pkg" ]]; then
    echo "Error: Tidak menemukan aplikasi '$query'" >&2
    exit 1
  fi

  if [[ "$launch_force_stop" -eq 1 ]]; then
    run_adb shell am force-stop "$pkg" >/dev/null 2>&1 || true
  fi

  if [[ "$launch_freeform" -eq 1 ]]; then
    run_adb shell settings put global enable_freeform_support 1 >/dev/null 2>&1 || true
    run_adb shell settings put global force_resizable_activities 1 >/dev/null 2>&1 || true
    if [[ "$comp" == */* ]]; then
      run_adb shell am start --display "$target_did" --windowingMode 5 -n "$comp"
    else
      run_adb shell cmd activity start-activity --display "$target_did" --windowingMode 5 "$pkg"
    fi
  else
    if [[ "$comp" == */* ]]; then
      run_adb shell am start --display "$target_did" --activity-reorder-to-front -n "$comp"
    else
      run_adb shell cmd activity start-activity --display "$target_did" "$pkg"
    fi
  fi

  if [[ "$launch_landscape" -eq 1 ]]; then
    apply_display_rotation_internal "$target_did" "landscape"
  fi
  echo "Launched $pkg on DeX display #$target_did"
}

