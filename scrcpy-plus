apply_display_rotation_internal() {
  local target_did="$1"
  local mode="$2"
  [[ -n "$target_did" && "$target_did" != "0" ]] || return 0

  # Check whether the virtual display's natural dimensions are already W >= H (landscape) or W < H (portrait)
  local size_str=""
  size_str="$(run_adb shell wm size -d "$target_did" 2>/dev/null | awk -F': ' '/size:/ {print $2}' | tail -n 1 | tr -d '\r ')"
  local w=1920
  local h=1080
  if [[ "$size_str" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    w="${BASH_REMATCH[1]}"
    h="${BASH_REMATCH[2]}"
  fi

  case "$mode" in
    landscape|land|0)
      run_adb shell settings put global force_resizable_activities 1 >/dev/null 2>&1 || true
      run_adb shell wm fixed-to-user-rotation -d "$target_did" enabled >/dev/null 2>&1 || true
      if (( w >= h )); then
        run_adb shell wm user-rotation -d "$target_did" lock 0 >/dev/null 2>&1 || true
      else
        run_adb shell wm user-rotation -d "$target_did" lock 1 >/dev/null 2>&1 || true
      fi
      ;;
    landscape-reverse|land-rev|180)
      run_adb shell settings put global force_resizable_activities 1 >/dev/null 2>&1 || true
      run_adb shell wm fixed-to-user-rotation -d "$target_did" enabled >/dev/null 2>&1 || true
      if (( w >= h )); then
        run_adb shell wm user-rotation -d "$target_did" lock 2 >/dev/null 2>&1 || true
      else
        run_adb shell wm user-rotation -d "$target_did" lock 3 >/dev/null 2>&1 || true
      fi
      ;;
    portrait|port|90)
      run_adb shell wm fixed-to-user-rotation -d "$target_did" enabled >/dev/null 2>&1 || true
      if (( w >= h )); then
        run_adb shell wm user-rotation -d "$target_did" lock 1 >/dev/null 2>&1 || true
      else
        run_adb shell wm user-rotation -d "$target_did" lock 0 >/dev/null 2>&1 || true
      fi
      ;;
    auto|free)
      run_adb shell wm fixed-to-user-rotation -d "$target_did" disabled >/dev/null 2>&1 || true
      run_adb shell wm user-rotation -d "$target_did" free >/dev/null 2>&1 || true
      ;;
  esac
}

