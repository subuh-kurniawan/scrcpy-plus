run_adb() {
  if [[ -n "$serial" ]]; then
    "$ADB_BIN" -s "$serial" "$@"
  elif [[ "$select_usb" -eq 1 ]]; then
    "$ADB_BIN" -d "$@"
  else
    "$ADB_BIN" "$@"
  fi
}

ensure_adb() {
  if [[ -z "$ADB_BIN" || ( ! -x "$ADB_BIN" && ! -f "$ADB_BIN" ) ]]; then
    echo "Error: ADB binary not found: $ADB_BIN" >&2
    exit 1
  fi
}

show_status_cmd() {
  ensure_adb
  echo "ADB binary: $ADB_BIN"
  echo "scrcpy binary: $SCRCPY_BIN"
  if ! "$ADB_BIN" version >/dev/null 2>&1; then
    echo "ADB is not available or not working correctly." >&2
    exit 1
  fi
  echo ""
  "$ADB_BIN" devices -l
}

detect_device_wifi_ip() {
  local ip=""
  # Stage 1: Direct IPv4 address on wlan0 / wlan1 / ap0 / swlan0 (Accurate on Android 12/13/14/15 even when Mobile Data is on)
  ip="$(run_adb shell ip -f inet addr show wlan0 2>/dev/null | awk '/inet / {split($2,a,"/"); print a[1]; exit}' | tr -d '\r ')"
  if [[ -z "$ip" ]]; then
    ip="$(run_adb shell ip -f inet addr show 2>/dev/null | awk '
      /^[0-9]+: (wlan|ap|swlan|eth|rndis)/ { iface=1; next }
      /^[0-9]+: / { iface=0 }
      iface && /inet / { split($2,a,"/"); print a[1]; exit }
    ' | tr -d '\r ')"
  fi
  # Stage 2: Per-interface routing table for wlan0 (Android 13+ policy routing)
  if [[ -z "$ip" ]]; then
    ip="$(run_adb shell ip route show table wlan0 2>/dev/null | awk '/src/ {for(i=1;i<=NF;i++) if($i=="src") {print $(i+1); exit}}' | tr -d '\r ')"
  fi
  # Stage 3: Main routing table filtered for wlan
  if [[ -z "$ip" ]]; then
    ip="$(run_adb shell ip route 2>/dev/null | awk '/wlan/ && /src/ {for(i=1;i<=NF;i++) if($i=="src") {print $(i+1); exit}}' | tr -d '\r ')"
  fi
  # Stage 4: ifconfig / getprop fallback
  if [[ -z "$ip" ]]; then
    ip="$(run_adb shell ifconfig wlan0 2>/dev/null | awk '/inet addr:/{sub(/addr:/,"",$2); print $2; exit} /inet /{print $2; exit}' | tr -d '\r ')"
  fi
  if [[ -z "$ip" ]]; then
    ip="$(run_adb shell getprop dhcp.wlan0.ipaddress 2>/dev/null | tr -d '\r ')"
  fi
  # Stage 5: Any private LAN IPv4 address (192.168.x.x / 10.x.x.x / 172.16-31.x.x) from ip -f inet addr
  if [[ -z "$ip" ]]; then
    ip="$(run_adb shell ip -f inet addr show 2>/dev/null | awk '/inet (192\.168\.|172\.(1[6-9]|2[0-9]|3[0-1])\.)/ {split($2,a,"/"); print a[1]; exit}' | tr -d '\r ')"
  fi
  echo "$ip"
}

scan_wifi_cmd() {
  ensure_adb
  "$ADB_BIN" start-server >/dev/null 2>&1 || true

  local mac_ip=""
  mac_ip="$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || ifconfig 2>/dev/null | awk '/inet (192\.168\.|10\.|172\.(1[6-9]|2[0-9]|3[0-1])\.)/ && $2 != "127.0.0.1" {print $2; exit}')"
  echo "MAC_IP:${mac_ip:--}"

  # 0. List any already-connected TCP/IP ADB devices
  "$ADB_BIN" devices 2>/dev/null | awk 'NR>1 && $1 ~ /:[0-9]+$/ && $2 == "device" { print "FOUND:" $1 " (Connected Wi-Fi ADB)" }' || true

  # 1. If a USB device is attached, check its wlan0 IP directly and warm up ARP from phone -> Mac!
  if run_adb get-state >/dev/null 2>&1; then
    local usb_ip
    usb_ip="$(detect_device_wifi_ip)"
    if [[ -n "$usb_ip" ]]; then
      if [[ -n "$mac_ip" && "$mac_ip" != "-" ]]; then
        run_adb shell "ping -c 2 -W 1 $mac_ip >/dev/null 2>&1" || true
      fi
      echo "FOUND:${usb_ip}:5555 (USB Device Wi-Fi IP)"
    fi
  fi

  # 2. Check Android 11+ Wireless Debugging mDNS services via adb mdns services
  local mdns_out
  mdns_out="$("$ADB_BIN" mdns services 2>/dev/null | tr -d '\r' || true)"
  if [[ -n "$mdns_out" ]]; then
    echo "$mdns_out" | awk '/_adb/ {
      for (i=1; i<=NF; i++) {
        if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:[0-9]+$/) {
          print "FOUND:" $i " (mDNS Wireless Debugging)"
        }
      }
    }'
  fi

  # 3. Scan active ARP neighbor table + fast subnet DHCP range (.2..35, .100..130) for open TCP port 5555
  local subnet_prefix=""
  if [[ "$mac_ip" =~ ^([0-9]+\.[0-9]+\.[0-9]+)\.[0-9]+$ ]]; then
    subnet_prefix="${BASH_REMATCH[1]}"
  fi

  if [[ -n "$subnet_prefix" ]]; then
    local arp_ips
    arp_ips="$(arp -a -n 2>/dev/null | grep -v 'incomplete' | awk -F'[()]' '/\([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\)/ {print $2}' | grep -v '\.255$' | sort -u || true)"

    local sweep_list=()
    for ip in $arp_ips; do
      [[ "$ip" != "$mac_ip" && "$ip" != "${subnet_prefix}.1" ]] && sweep_list+=("$ip")
    done
    for host_num in {2..30} {100..120}; do
      local cand="${subnet_prefix}.${host_num}"
      if [[ "$cand" != "$mac_ip" ]]; then
        sweep_list+=("$cand")
      fi
    done

    local unique_ips
    unique_ips="$(printf "%s\n" "${sweep_list[@]}" | awk '!seen[$0]++')"

    for ip in $unique_ips; do
      (
        if nc -G 1 -w 1 -z "$ip" 5555 >/dev/null 2>&1; then
          echo "FOUND:${ip}:5555 (LAN Port 5555 Open)"
        fi
      ) &
    done
    wait
  fi
}

show_device_info_cmd() {
  ensure_adb
  if ! run_adb get-state >/dev/null 2>&1; then
    echo "Error: No active ADB device found. Connect a device or specify --serial." >&2
    exit 1
  fi
  local model manufacturer android_ver sdk_ver serial_no battery_lvl wm_size ip_addr
  manufacturer="$(run_adb shell getprop ro.product.manufacturer 2>/dev/null | tr -d '\r')"
  model="$(run_adb shell getprop ro.product.model 2>/dev/null | tr -d '\r')"
  android_ver="$(run_adb shell getprop ro.build.version.release 2>/dev/null | tr -d '\r')"
  sdk_ver="$(run_adb shell getprop ro.build.version.sdk 2>/dev/null | tr -d '\r')"
  serial_no="$(run_adb get-serialno 2>/dev/null | tr -d '\r')"
  battery_lvl="$(run_adb shell dumpsys battery 2>/dev/null | awk -F': ' '/level:/ {print $2; exit}' | tr -d '\r')"
  wm_size="$(run_adb shell wm size 2>/dev/null | awk -F': ' '/Physical size:/ {print $2; exit}' | tr -d '\r')"
  ip_addr="$(detect_device_wifi_ip)"

  echo "Device Information:"
  echo "  Serial       : ${serial_no:-unknown}"
  echo "  Device       : ${manufacturer:-unknown} ${model:-unknown}"
  echo "  Android      : ${android_ver:-unknown} (API ${sdk_ver:-?})"
  echo "  Screen Size  : ${wm_size:-unknown}"
  echo "  Battery      : ${battery_lvl:+${battery_lvl}%}${battery_lvl:-unknown}"
  echo "  Wi-Fi IP     : ${ip_addr:-not detected (check Wi-Fi on phone)}"
}

take_screenshot_cmd() {
  ensure_adb
  local out="$screenshot_path"
  if [[ -z "$out" ]]; then
    out="$HOME/Desktop/scrcpy-screenshot-$(date +%Y%m%d-%H%M%S).png"
  fi
  mkdir -p "$(dirname "$out")"
  if [[ -n "$screenshot_display_id" ]]; then
    local target_did="$screenshot_display_id"
    if [[ "$target_did" == "auto" ]]; then
      target_did="$(detect_virtual_display_id)"
    fi
    if [[ -n "$target_did" && "$target_did" != "0" ]]; then
      if run_adb exec-out screencap -d "$target_did" -p > "$out"; then
        echo "DeX Screenshot (Display #$target_did) saved to: $out"
        return 0
      fi
    fi
  fi
  if run_adb exec-out screencap -p > "$out"; then
    echo "Screenshot saved to: $out"
  else
    rm -f "$out"
    echo "Error: Failed to capture screenshot from device." >&2
    exit 1
  fi
}

list_files_cmd() {
  ensure_adb
  local dir="${list_files_dir:-/sdcard/Download}"
  run_adb shell "ls -1p '$dir' 2>/dev/null | head -n 80" | tr -d '\r'
}

pull_file_cmd() {
  ensure_adb
  mkdir -p "$pull_dest"
  echo "Pulling $pull_src -> $pull_dest ..."
  run_adb pull "$pull_src" "$pull_dest"
}

display_dpi_cmd() {
  ensure_adb
  local target_did="$display_dpi_id"
  if [[ "$target_did" == "auto" || -z "$target_did" ]]; then
    target_did="$(detect_virtual_display_id)"
  fi
  if [[ -z "$target_did" || "$target_did" == "0" ]]; then
    echo "Error: Virtual display DeX belum aktif." >&2
    exit 1
  fi
  if [[ "$display_dpi_val" == "reset" ]]; then
    run_adb shell wm density reset -d "$target_did" >/dev/null 2>&1 || run_adb shell wm density -d "$target_did" reset >/dev/null 2>&1 || true
    echo "DeX Display #$target_did DPI di-reset ke default"
  else
    run_adb shell wm density "$display_dpi_val" -d "$target_did" >/dev/null 2>&1 || run_adb shell wm density -d "$target_did" "$display_dpi_val" >/dev/null 2>&1 || true
    echo "DeX Display #$target_did DPI diatur ke: $display_dpi_val"
  fi
}

install_apk_cmd() {
  ensure_adb
  if [[ ! -f "$install_apk_path" ]]; then
    echo "Error: APK file not found: $install_apk_path" >&2
    exit 1
  fi
  echo "Installing $install_apk_path ..."
  run_adb install -r "$install_apk_path"
}

push_file_cmd() {
  ensure_adb
  if [[ ! -e "$push_src" ]]; then
    echo "Error: Source path not found: $push_src" >&2
    exit 1
  fi
  echo "Pushing $push_src -> $push_dest ..."
  run_adb push "$push_src" "$push_dest"
}

send_text_cmd() {
  ensure_adb
  local escaped="${send_text_val// /%s}"
  run_adb shell input text "$escaped"
  echo "Text sent to device."
}

keyevent_cmd() {
  ensure_adb
  run_adb shell input keyevent "$keyevent_val"
  echo "Keyevent '$keyevent_val' sent."
}

detect_virtual_display_id() {
  local did=""
  # 1. Fast & accurate: parse dumpsys display for non-zero display IDs associated with scrcpy / virtual display
  did="$(run_adb shell dumpsys window displays 2>/dev/null | awk '
    /Display: mDisplayId=[1-9][0-9]*/ {
      if (match($0, /mDisplayId=[0-9]+/)) {
        val = substr($0, RSTART + 11, RLENGTH - 11)
        last = val
      }
    }
    END { if (last != "") print last }
  ' | tr -d '\r ')"

  # 2. Fallback: dumpsys display mDisplayId != 0
  if [[ -z "$did" || "$did" == "0" ]]; then
    did="$(run_adb shell dumpsys display 2>/dev/null | awk -F'[=,]' '/mDisplayId=[1-9][0-9]*/ {last=$2} END {print last}' | tr -d '\r ')"
  fi

  # 3. Fallback: scrcpy --list-displays
  if [[ -z "$did" || "$did" == "0" ]]; then
    did="$("$SCRCPY_BIN" ${serial:+-s "$serial"} --list-displays 2>&1 | awk -F'=' '/--display-id=/ && $2 !~ /^0 / {print $2}' | awk '{print $1}' | tail -n 1 | tr -d '\r ')"
  fi

  echo "$did"
}

wait_for_virtual_display_id() {
  local target_did="$1"
  if [[ -n "$target_did" && "$target_did" != "auto" && "$target_did" != "0" ]]; then
    echo "$target_did"
    return 0
  fi
  local attempt=0
  local detected=""
  while (( attempt < 10 )); do
    detected="$(detect_virtual_display_id)"
    if [[ -n "$detected" && "$detected" != "0" ]]; then
      echo "$detected"
      return 0
    fi
    sleep 0.35
    (( attempt++ ))
  done
  echo ""
}

resolve_package_and_activity() {
  local raw_query="$1"
  local clean="${raw_query#+}"
  clean="${clean#\?}"

  local pkg="$clean"
  # Verify if exact package exists; if not, search case-insensitively
  if ! run_adb shell pm path "$pkg" >/dev/null 2>&1; then
    pkg="$(run_adb shell pm list packages 2>/dev/null | sed 's/^package://' | tr -d '\r' | grep -i "$clean" | head -n 1)"
  fi
  if [[ -z "$pkg" ]]; then
    echo ""
    return 1
  fi

  local comp=""
  comp="$(run_adb shell cmd package resolve-activity --brief -a android.intent.action.MAIN -c android.intent.category.LAUNCHER "$pkg" 2>/dev/null | tail -n 1 | tr -d '\r ')"
  if [[ "$comp" != */* ]]; then
    comp="$(run_adb shell cmd package resolve-activity --brief -a android.intent.action.MAIN -c android.intent.category.INFO "$pkg" 2>/dev/null | tail -n 1 | tr -d '\r ')"
  fi
  if [[ "$comp" != */* ]]; then
    comp="$(run_adb shell cmd package resolve-activity --brief "$pkg" 2>/dev/null | tail -n 1 | tr -d '\r ')"
  fi
  if [[ "$comp" != */* ]]; then
    comp="$(run_adb shell dumpsys package "$pkg" 2>/dev/null | awk '/android.intent.action.MAIN:/{flag=1;next} flag && /\//{for(i=1;i<=NF;i++) if($i ~ /\//){print $i; exit}}' | tr -d '\r ')"
  fi

  echo "${pkg}|${comp}"
}

