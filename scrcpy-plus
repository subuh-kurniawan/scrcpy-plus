prepare_wireless() {
  if [[ "$wireless" -ne 1 ]]; then
    return 0
  fi

  ensure_adb

  if ! run_adb get-state >/dev/null 2>&1; then
    echo "No ADB device connected. Connect your phone via USB or Wi-Fi first." >&2
    exit 1
  fi

  # Check if already connected purely via TCP/IP
  local current_serial
  current_serial="$(run_adb get-serialno 2>/dev/null | tr -d '\r' || true)"
  if [[ "$current_serial" == *:* ]]; then
    echo "Already connected over Wi-Fi ($current_serial)." >&2
    return 0
  fi

  local ip
  ip="$(detect_device_wifi_ip)"
  if [[ -z "$ip" ]]; then
    echo "Unable to detect device Wi-Fi IP on wlan0, falling back to scrcpy --tcpip..." >&2
    tcpip_addr="auto"
    wireless=0
    return 0
  fi

  local mac_ip=""
  mac_ip="$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true)"
  if [[ -n "$mac_ip" ]]; then
    # Warm up reverse ARP from Android phone to Mac so hotspot/router populates ARP immediately
    run_adb shell "ping -c 2 -W 1 $mac_ip >/dev/null 2>&1" || true
  fi

  run_adb tcpip 5555 >/dev/null 2>&1 || true
  sleep 1
  if [[ -n "$mac_ip" ]]; then
    run_adb shell "ping -c 1 -W 1 $mac_ip >/dev/null 2>&1" || true
  fi
  ping -c 1 -t 1 "$ip" >/dev/null 2>&1 || true

  local conn_out=""
  conn_out="$("$ADB_BIN" connect "${ip}:5555" 2>&1 || true)"
  if [[ "$conn_out" == *"No route to host"* || "$conn_out" == *"cannot connect"* || "$conn_out" == *"failed to connect"* ]]; then
    "$ADB_BIN" kill-server >/dev/null 2>&1 || true
    "$ADB_BIN" start-server >/dev/null 2>&1 || true
    "$ADB_BIN" connect "${ip}:5555" >/dev/null 2>&1 || true
  fi
  serial="${ip}:5555"
}

apply_profile() {
  case "$profile" in
    ""|default)
      ;;
    gaming)
      if [[ "$windowed" -eq 0 ]]; then fullscreen=1; fi
      scrcpy_args+=(--show-touches --disable-screensaver)
      if [[ -z "$bitrate" ]]; then bitrate="20M"; fi
      if [[ -z "$fps" ]]; then fps="60"; fi
      ;;
    recording)
      if [[ -z "$record_path" ]]; then
        record_path="$HOME/Desktop/scrcpy-$(date +%Y%m%d-%H%M%S).mp4"
      fi
      if [[ -z "$bitrate" ]]; then bitrate="30M"; fi
      if [[ -z "$audio_source" ]]; then audio_source="output"; fi
      ;;
    presentation)
      if [[ "$windowed" -eq 0 ]]; then fullscreen=1; fi
      scrcpy_args+=(--show-touches)
      if [[ -z "$bitrate" ]]; then bitrate="12M"; fi
      if [[ -z "$window_title" ]]; then window_title="scrcpy presentation"; fi
      ;;
    productivity)
      stay_awake=1
      if [[ -z "$bitrate" ]]; then bitrate="8M"; fi
      if [[ -z "$window_title" ]]; then window_title="scrcpy productivity"; fi
      ;;
    debug)
      scrcpy_args+=(--show-touches --disable-screensaver --print-fps)
      if [[ -z "$bitrate" ]]; then bitrate="10M"; fi
      if [[ -z "$window_title" ]]; then window_title="scrcpy debug"; fi
      ;;
    windowed)
      windowed=1
      if [[ -z "$window_title" ]]; then window_title="scrcpy windowed"; fi
      if [[ -z "$bitrate" ]]; then bitrate="9M"; fi
      ;;
    private)
      scrcpy_args+=(--disable-screensaver -S --power-off-on-close)
      show_touches=0
      if [[ -z "$window_title" ]]; then window_title="scrcpy private"; fi
      ;;
    studio)
      scrcpy_args+=(--show-touches --disable-screensaver)
      if [[ -z "$video_codec" ]]; then video_codec="h265"; fi
      if [[ -z "$bitrate" ]]; then bitrate="15M"; fi
      if [[ -z "$window_title" ]]; then window_title="scrcpy studio"; fi
      ;;
    camera|webcam)
      video_source="camera"
      if [[ -z "$camera_facing" ]]; then camera_facing="back"; fi
      if [[ -z "$camera_size" && -z "$camera_ar" ]]; then camera_size="1920x1080"; fi
      if [[ -z "$camera_fps" ]]; then camera_fps="30"; fi
      if [[ -z "$window_title" ]]; then window_title="scrcpy camera"; fi
      ;;
    desktop|dex)
      use_new_display=1
      if [[ -z "$new_display" ]]; then new_display="1280x800/180"; fi
      no_vd_destroy_content=1
      no_vd_system_decorations=1
      if [[ -z "$display_ime_policy" ]]; then display_ime_policy="hide"; fi
      if [[ "$fullscreen" -eq 0 && -z "$window_width" && -z "$window_height" ]]; then
        window_width="1280"
        window_height="800"
      fi
      if [[ -z "$bitrate" ]]; then bitrate="16M"; fi
      if [[ -z "$fps" ]]; then fps="60"; fi
      if [[ -z "$window_title" ]]; then window_title="scrcpy DeX Desktop"; fi
      if [[ -z "$start_app" ]]; then
        start_app="+com.android.settings"
      elif [[ "$start_app" != +* ]]; then
        start_app="+$start_app"
      fi
      ;;
    audio-only)
      no_video=1
      no_window=1
      if [[ -z "$audio_source" ]]; then audio_source="output"; fi
      ;;
    low-latency)
      if [[ -z "$max_size" ]]; then max_size="1024"; fi
      if [[ -z "$bitrate" ]]; then bitrate="4M"; fi
      if [[ -z "$fps" ]]; then fps="60"; fi
      if [[ -z "$window_title" ]]; then window_title="scrcpy low-latency"; fi
      ;;
    otg)
      otg_mode=1
      ;;
    *)
      echo "Unknown profile: $profile" >&2
      list_available_profiles >&2
      exit 1
      ;;
  esac
}

